					(name "Description") "Rule 251 (Track Signaled in One Direction): Governs movements on tracks where signals are only configured for  one direction.  Under this rule, signal indications supersede the superiority of trains for movements operating with the current of traffic.  Moving against this traffic direction requires explicit authority (such as a train order or track warrant).")
				(field
					(name "Rulebook") "251")
				(field
					(name "Direction") "RIGHT")
			)
			(pins
				(pin
					(num "1")
					(name "To")
					(type "passive")
				)
			)
		)
		(libpart
			(lib "Railroad")
			(part "Rule261-DoT-BiDirectional")
			(description "Track Signaled in Both Directions:  Governs bi-directional signal territory (often controlled by  Centralized Traffic Control, or CTC).  Under Rule 261, block signal  indications supersede train superiority for both opposing and following movements on the same track, allowing the dispatcher to dynamically change the direction of traffic by clearing signals.")
			(fields
				(field
					(name "Reference") "DOT")
				(field
					(name "Value") "Rule 261")
				(field
					(name "Footprint")
				)
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Track Signaled in Both Directions:  Governs bi-directional signal territory (often controlled by  Centralized Traffic Control, or CTC).  Under Rule 261, block signal  indications supersede train superiority for both opposing and following movements on the same track, allowing the dispatcher to dynamically change the direction of traffic by clearing signals.")
				(field
					(name "Rulebook") "261")
				(field
					(name "Direction") "BOTH")
			)
			(pins
				(pin
					(num "1")
					(name "")
					(type "passive")
				)
			)
		)
		(libpart
			(lib "Railroad")
			(part "Rule6.28-OtherThanMain")
			(description "This is the foundational rule governing most industrial tracks. It mandates that trains or engines must move at a speed that allows them to stop within half the range of vision short of a train, engine, car, stop signal, derail, or switch improperly lined. It also requires crew members to look out for track obstructions")
			(fields
				(field
					(name "Reference") "DOT")
				(field
					(name "Value") "Rule 6.28")
				(field
					(name "Footprint")
				)
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "This is the foundational rule governing most industrial tracks. It mandates that trains or engines must move at a speed that allows them to stop within half the range of vision short of a train, engine, car, stop signal, derail, or switch improperly lined. It also requires crew members to look out for track obstructions")
				(field
					(name "Rulebook") "Rule 6.28")
				(field
					(name "Direction") "BOTH")
				(field
					(name "Name") "Movement on Other Than Main Track")
			)
			(pins
				(pin
					(num "1")
					(name "To")
					(type "passive")
				)
			)

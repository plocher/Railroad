	(text "LEGACY DIAGRAM AND NOTES\n\n   \n       Gilroy Interchange\n   \n       < Railroad West/North                             Railroad East/South >\n   \n              MC1 2Nc O-|                 MC2\n                      /=== ==INTER== ===\\\n                     /               |-O \\ 2Sc\n                1T1 /                 3T1 \\  oo--| 2Nab\n       MT  =1SA= ==+==== =====TK1===== ====+=== =CP_Luchessa:1SA=   MT\n                |--oo 2Sab\n   \n       Single track  north of Luchessa to Michael\n   \n       1T - MT to north interchange - LOCK, local control\n       3T - MT to south interchange - LOCK, local control\n   \n        EastBound Approach from Michael EA\n        West Approach from Luchessa WA"
		(exclude_from_sim no)
		(at 98.298 127.508 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dfa733f8-aba3-44c0-a2f0-b7a72841b689")
	)
	(text "As a modeler simplification, the signals here are tied to their locked switches; there are NO signal levers.\nif the dispatcher unlocks them and they are aligned for transit, \nthe siding's signals change from STOP / RED to RESTRICTING / (RED)\nand the mainline from CLEAR|STOP/GREEN|RED to STOP|RESTRICTING/RED|(RED)"
		(exclude_from_sim no)
		(at 122.936 28.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e3457844-df0c-4834-8686-3d432ab66977")
	)

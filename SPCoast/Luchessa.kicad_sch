	(text "Industry"
		(exclude_from_sim no)
		(at 50.8 67.564 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "190af2f5-c1b3-4ead-a625-f2854766ea25")
	)
	(text "Rule 261 (Track Signaled in Both Directions): \nGoverns bi-directional signal territory (often controlled by \nCentralized Traffic Control, or CTC).  Under Rule 261, block signal \nindications supersede train superiority for both opposing and\nfollowing movements on the same track, allowing the dispatcher to\ndynamically change the direction of traffic by clearing signals."
		(exclude_from_sim no)
		(at 320.548 77.978 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2848dfa1-d736-4bf4-9d84-5010f4d76aba")
	)
	(text "Rule 251 (Track Signaled in One Direction):\nGoverns movements on tracks where signals are only configured for \none direction.  Under this rule, signal indications supersede the\nsuperiority of trains for movements operating with the current of\ntraffic.  Moving against this traffic direction requires explicit\nauthority (such as a train order or track warrant)."
		(exclude_from_sim no)
		(at 320.548 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2957594c-4eb2-4a8b-a14b-bc54d49ec884")
	)
	(text "Track and Movement Definitions Rule D-151 & D-152 (Current of Traffic):\nThe \"D\" prefix denotes rules specifically for two or more tracks.  \nThese rules establish that on double tracks, trains must run with \nthe current of traffic (the designated normal direction for that\ntrack, such as keeping to the right) unless otherwise authorized."
		(exclude_from_sim no)
		(at 320.548 61.468 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "35eeb7bb-f330-47a0-95f8-3c670394d503")
	)
	(text "Luchessa\nMP 78.3"
		(exclude_from_sim no)
		(at 247.65 22.606 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 1.016)
				(bold yes)
			)
		)
		(uuid "4a455492-465c-42f8-92cd-14084424a118")
	)
	(text "Yellow circle on a switch denotes the OS track circuit\nIt indicates when the turnout is occupued\nIt is usually denoted as <SWITCHNUMBER>T1"
		(exclude_from_sim no)
		(at 320.802 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "584a86df-8fc7-48da-9c20-61cf76b1e39d")
	)
	(text "Rule 262 (Reversing Direction):\nMandates that once a direction of traffic has been established for \na train in bi-directional territory, the train must not move in the\nopposite direction without proper interlocking signal indications\nor direct permission from the train dispatcher."
		(exclude_from_sim no)
		(at 320.548 93.472 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "58ebab91-c42b-4b3e-bd6b-4a9b33ac52c4")
	)
	(text "TRAFFIC"
		(exclude_from_sim no)
		(at 217.678 39.116 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7f4503c4-5eac-4cb3-a458-eba9f97a722a")
	)

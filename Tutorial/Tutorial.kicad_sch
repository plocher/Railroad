	(text "The levers and lamps that make up\nthe cTc machine are connected to a \nmicrocontroller over a Panel IO Bus."
		(exclude_from_sim no)
		(at 64.262 127.762 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0457f52a-4038-4c2f-b139-bc47a634d628")
	)
	(text "The \"Railroad\" symbol is where Layout-wide\ninformation is stored:\n  - We are modeling Southern Pacific's \n    Coast Line south of San Jose in the 1980s\n  - Southern Pacific switched to the common\n    General Code of Operating Rules in 1985"
		(exclude_from_sim no)
		(at 211.836 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0976b7e8-3f1c-4715-a561-e887da868479")
	)
	(text "The Dispatcher\n(Remote Control)"
		(exclude_from_sim no)
		(at 36.83 89.662 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "0b8da9d8-0a15-47e5-94ba-ca1c63d963d6")
	)
	(text "A control point (CP) is a specific location on a railroad's\nmain track  where a train dispatcher or control operator\nremotely operates track switches and signals. Most control points \nfunction as interlockings-an arrangement of signals and track switches\ndesigned to prevent conflicting train movements or derailments."
		(exclude_from_sim no)
		(at 21.082 39.878 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0df4349a-dce2-4746-ab35-0d1d20239dec")
	)
	(text "(4)"
		(exclude_from_sim no)
		(at 21.336 89.408 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "0e532aca-e77b-4781-b3ba-42c5aef23eac")
	)
	(text "Inside this cTc machine is a processor\nthat manages the column levers and\nlamps, interacts with the units in the\nfield over a codeline and executes any\nnecessary logic."
		(exclude_from_sim no)
		(at 64.262 137.414 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0fcd8346-84a8-4350-9d7d-f0724839a61b")
	)
	(text "(6)"
		(exclude_from_sim no)
		(at 173.736 99.568 0)
		(effects

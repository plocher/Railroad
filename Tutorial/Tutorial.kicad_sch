	)
	(text "A Control Point is more than simply a switch on a layout.  As its name implies\na \"Controlled Point\" is a location on the railroad with a signal that is\nauthorized to control the movement of trains.  The CP's environment includes\n  - A railroad (or in our case a model railroad layout)\n  - a remote dispatcher with a traffic control device on their desk\n  - a local unit in the field that manages trackside appliances in a safe way\n  - a way for the two to comminicate (a codeline)\n  - trackside appliances include:\n      - a track switch\n      - Signals\n      - track circuits\n      - a maintainer call lamp on an equipment bungalow with a telephone\n"
		(exclude_from_sim no)
		(at 21.082 63.754 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b40cac49-dbca-40da-ba6b-17093c69f471")
	)
	(text "cTc Machine\n(Office Unit)\nWiring"
		(exclude_from_sim no)
		(at 133.604 88.138 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 1.016)
				(bold yes)
			)
		)
		(uuid "c5ae1e98-2567-444e-8c62-cbc431fb90fe")
	)
	(text "Field Wiring"
		(exclude_from_sim no)
		(at 188.976 100.076 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "e6f2d0bd-8f90-47af-ba35-ef8bf19dec15")
	)
	(text "The Dispatcher uses an OfficeUnit\n(aka a cTc machine or desk) to\ninteract with remote interlockings\n(aka Field Units).\n\nWe've chosen to model a US&S\nType 6 style design. This unit\nwill be used to control the \n\"Example-01\" division on the\n\"Tutorial\" layout, with one\ncolumn of levers."
		(exclude_from_sim no)
		(at 63.754 112.014 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "eed647f9-fdb2-44cd-b15a-453a9366d210")
	)
	(text "TRACKPLAN"
		(exclude_from_sim no)

	(text "Note the appliance types\nand names used in the Office\nmatch those used in the Field\nand in the trackplan"
		(exclude_from_sim no)
		(at 228.346 33.274 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3ebea49c-d6f1-473e-b59c-8dde5e4a8d38")
	)
	(text "A Codeline connects the Office Unit\nto all the Field Units. A codeline\nis a transport mechanism plus an\nencoding protocol, in this case a \nset of MQTT topics with Control and\nIndication messages made up of AAR\ntext tokens.\n"
		(exclude_from_sim no)
		(at 64.516 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6a058d50-97db-47da-a2ba-7e1c5e75c5fd")
	)
	(text "(1)"
		(exclude_from_sim no)
		(at 19.304 19.558 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "6f8c880b-8f27-4248-9974-8b7988dc7006")
	)
	(text "(3)"
		(exclude_from_sim no)
		(at 176.53 166.624 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "78b4d964-1760-4a35-bd23-fd1286ea9de7")
	)
	(text "The dispatcher works in a remote office, usually at a\ndesk with a cTc machine, paperwork and a telephone."
		(exclude_from_sim no)
		(at 19.558 97.536 0)
		(effects
			(font
